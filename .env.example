# 默认大模型：deepseek
LLM_PROVIDER=deepseek

# ---------- DeepSeek ----------
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# NCBI PubMed（可选，有 key 可提高频率限制）
# 申请：https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# 每次检索最多返回文献数（>100 时自动分段下载后合并；硬上限 1500）
PUBMED_MAX_RESULTS=1500

# 检索项目根目录：每次新检索按其中的 _template 新建一个项目
# 摘要 txt 写在项目根目录，全文 PDF 写入项目内 _full_pdf
PROJECTS_DIR=E:\BaiduSyncdisk\文献2024\pubmed_projects

# ---------- Notion 导出（可选）----------
# 集成：https://www.notion.so/my-integrations
# 创建 Internal Integration 后，把数据库 Share 给该集成
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_VERSION=2022-06-28

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
