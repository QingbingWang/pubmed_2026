# 默认大模型：glm | deepseek
LLM_PROVIDER=glm

# ---------- 智谱 GLM ----------
# 国内：https://open.bigmodel.cn
# 国际：https://z.ai
GLM_API_KEY=your_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# GLM_BASE_URL=https://api.z.ai/api/paas/v4/
GLM_MODEL=glm-5.2

# ---------- DeepSeek ----------
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# NCBI PubMed（可选，有 key 可提高频率限制）
# 申请：https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# 每次检索最多返回文献数（>100 时自动分段下载后合并；硬上限 1500）
PUBMED_MAX_RESULTS=1500

# ---------- Notion 导出（可选）----------
# 集成：https://www.notion.so/my-integrations
# 创建 Internal Integration 后，把数据库 Share 给该集成
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_VERSION=2022-06-28

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
